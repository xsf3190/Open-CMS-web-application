CREATE OR REPLACE EDITIONABLE PACKAGE "PCK_STYLES" as
    --
    PROCEDURE getStylesForm(pWebsiteId IN website.id%type, pArticleId IN article.id%type, pStyle IN NUMBER, pStatus OUT NUMBER);
    --
    PROCEDURE updateStyle(pWebsiteId IN NUMBER, pArticleid IN NUMBER, pBodyText IN CLOB, pStatus OUT NUMBER);
    --
end "PCK_STYLES";
/
CREATE OR REPLACE EDITIONABLE PACKAGE BODY "PCK_STYLES" as

    FUNCTION getStyleHTML(pWebsiteid IN NUMBER, pStyleId IN NUMBER) RETURN VARCHAR2 IS
        l_html LONG;
    BEGIN
        FOR C IN (
            SELECT s.title, s.property, s.min, s.max, NVL(ws.value, s.value) AS value 
              FROM styles s, website_styles ws
             WHERE s.id=pStyleId
               AND ws.website_id(+)=pWebsiteid
               AND ws.style_id(+)=s.id
        ) LOOP
            IF (C.max IS NOT NULL) THEN -- build input type="range"
                l_html:=
                '<label for="' || C.property || '">Adjust value:</label>' ||
                '<input type="range" id="' || C.property || '" min="' || C.min || '" max="' || C.max || '" value="' || regexp_substr(C.value,'\d+') || '">';
            ELSIF (C.value LIKE '#%') THEN -- build input type="color"
                l_html:=
                '<label for="' || C.property || '">Select colour:</label>' ||
                '<input type="color" id="' || C.property || '" value="' || C.value || '">';
            END IF;       
        END LOOP;
        
        RETURN (l_html);
    END;

    /* 
    **  BUILD FORM CONTROLS TO MANAGE WEBSITE PAGES
    */
    PROCEDURE getStylesForm(pWebsiteId IN website.id%type, pArticleId IN article.id%type, pStyle IN NUMBER, pStatus OUT NUMBER) IS
        l_session_data pck_sec.t_session_data;
        l_header LONG;
        l_article CLOB;
        l_footer LONG;
        l_json JSON_OBJECT_T;
    BEGIN
        l_session_data:=pck_sec.getSessionData(pWebsiteId);

        IF (pStyle IS NOT NULL) THEN
            l_json:= new JSON_OBJECT_T;
            l_json.put('input',getStyleHTML(pWebsiteId,pStyle));
            apex_util.prn(l_json.to_clob,false);
            pStatus:=200;
            RETURN;
        END IF;
        
        l_header:=
        '<h4>Update Styles</h4>' ||
        '<div class="flex-items show-controls">' ||
            '<div>' ||
                '<input id="website-styles" type="radio" name="context" checked>' ||
                '<label for="website-styles" style="margin-inline-start:var(--space-3xs)">All Pages</label>' ||
            '</div>' ||
            '<div>' ||
                '<input id="page-styles" type="radio" name="context">' ||
                '<label for="page-styles" style="margin-inline-start:var(--space-3xs)">Current Page</label>' ||
            '</div>' ||
        '</div>';

        l_article:=
        '<fieldset>' ||
            '<legend>Select style and adjust</legend>' ||
            '<div class="flex-items">' ||
                -- '<label class="block" for="styles"></label>' ||
                '<select id="styles" style="--width:fit-content">' ||
                    '<button>' ||
                        '<selectedcontent></selectedcontent>' ||
                    '</button>' ||
                    '<option value="">-- Choose styling element --</option>';

        FOR C IN (
            SELECT id, parent_id, title, property, value, LAG(LEVEL) OVER (ORDER BY id) prev_level
              FROM styles
             START WITH parent_id IS NULL
           CONNECT BY parent_id = PRIOR id
             ORDER BY id
        ) LOOP
            IF (C.parent_id IS NULL) THEN
                l_article:=l_article ||
                CASE WHEN C.prev_level=2 THEN '</optgroup>' END ||
                '<optgroup><legend>' || C.title || '</legend>';
            ELSE
                l_article:=l_article ||
                '<option value="' || C.id || '">' || C.title || '</option>';
            END IF;
        END LOOP;

        l_article:=l_article ||
                    '</optgroup>' ||
                '</select>' ||
                '<div class="flex-items" style="--flex-gap:var(--space-2xs)"></div>' ||
            '</div>' ||
        '</fieldset>';

        l_footer:=
        '<div class="flex-items">' ||
            '<button type="button" class="button publish">PUBLISH</button>' ||
            '<span aria-live="polite"></span>' ||
            '<span class="loader icon"></span>' ||
        '</div>';

        l_json:= new JSON_OBJECT_T;
        l_json.put('success',true);
        l_json.put('header',l_header);
        l_json.put('article',l_article);
        l_json.put('footer',l_footer);
        apex_util.prn(l_json.to_clob,false);

        pStatus:=200;

    EXCEPTION WHEN OTHERS THEN
        pck_core.log_error(pStatus);

    END;

    /* 
    **  UPDATE A STYLE
    */
    PROCEDURE updateStyle(pWebsiteId IN NUMBER, pArticleid IN NUMBER, pBodyText IN CLOB, pStatus OUT NUMBER) IS
        l_session_data pck_sec.t_session_data;
        l_bodytext CLOB;
        l_context VARCHAR2(15);
        l_style_id NUMBER;
        l_unit VARCHAR2(5);
        l_json JSON_OBJECT_T;
        l_message VARCHAR2(100);
    BEGIN
        l_session_data:=pck_sec.getSessionData(pWebsiteId);

        l_bodytext:=pBodyText;

        SELECT context, style_id
          INTO l_context, l_style_id
          FROM JSON_TABLE(l_bodytext, '$' COLUMNS(context, style_id));

        CASE l_context 
            WHEN 'website-styles' THEN
                MERGE INTO website_styles t
                USING (
                    SELECT j.style_id, j.value || CASE WHEN j.value NOT LIKE '#%' THEN regexp_substr(s.value,'[[:lower:]]+$') END AS value
                      FROM JSON_TABLE(l_bodytext, '$' COLUMNS(style_id, property, value)) j, styles s
                     WHERE s.id=j.style_id
                ) s
                ON (t.website_id=pWebsiteid AND t.style_id=s.style_id)
                WHEN MATCHED THEN      
                    UPDATE SET t.value=s.value, t.updated_date=current_timestamp
                WHEN NOT MATCHED THEN
                    INSERT (website_id, style_id, value) VALUES (pWebsiteid, s.style_id, s.value);

                SELECT '<span>Updated ' || title || ' for all pages</span>' INTO l_message FROM styles WHERE id=l_style_id;

            WHEN 'page-styles' THEN
                MERGE INTO website_article_styles t
                USING (
                    SELECT j.style_id, j.value || CASE WHEN j.value NOT LIKE '#%' THEN regexp_substr(s.value,'[[:lower:]]+$') END AS value
                      FROM JSON_TABLE(l_bodytext, '$' COLUMNS(style_id, property, value)) j, styles s
                     WHERE s.id=j.style_id
                ) s
                ON (t.website_id=pWebsiteid AND t.article_id=pArticleid AND t.style_id=s.style_id)
                WHEN MATCHED THEN      
                    UPDATE SET t.value=s.value, t.updated_date=current_timestamp
                WHEN NOT MATCHED THEN
                    INSERT (website_id, article_id, style_id, value) VALUES (pWebsiteid, pArticleid, s.style_id, s.value);

                SELECT '<span>Updated ' || s.title || ' for ' || wa.navigation_label || ' page</span>' INTO l_message 
                  FROM styles s, website_article wa
                 WHERE s.id=l_style_id
                   AND wa.website_id=pWebsiteid
                   AND wa.article_id=pArticleid;
        END CASE;

        l_json:= new JSON_OBJECT_T;
        l_json.put('message',l_message);
        apex_util.prn(l_json.to_clob,false);

        pStatus:=200;

        pck_sec.updateCpuUsed(pWebsiteId=>pWebsiteId, pUserid=>l_session_data.user_id, pCpuUsedStart=>l_session_data.cpu_used_session);

    EXCEPTION WHEN OTHERS THEN
        pck_core.log_error(pStatus);

    END;

end "PCK_STYLES";
/