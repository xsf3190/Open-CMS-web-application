CREATE OR REPLACE EDITIONABLE PACKAGE "PCK_STYLES" as
    --
    PROCEDURE getStylesForm(pWebsiteId IN website.id%type, pArticleId IN article.id%type, pStyle IN NUMBER, pScope IN VARCHAR2, pStatus OUT NUMBER);
    --
    PROCEDURE updateStyle(pWebsiteId IN NUMBER, pArticleid IN NUMBER, pBodyText IN CLOB, pStatus OUT NUMBER);
    --
    PROCEDURE initFluidTypes( pParentid IN NUMBER, pMinWidthPx IN NUMBER, pMinFontSizePx IN NUMBER, pMinScale IN NUMBER, pMaxWidthPx IN NUMBER, pMaxFontSizePx IN NUMBER, pMaxScale IN NUMBER);
    --
    PROCEDURE initStyles;
    --
end "PCK_STYLES";
/
CREATE OR REPLACE EDITIONABLE PACKAGE BODY "PCK_STYLES" as

    FUNCTION getStyleProperties(pWebsiteid IN NUMBER, pStyleId IN NUMBER, pScope IN VARCHAR2) RETURN VARCHAR2 IS
        l_properties LONG;
    BEGIN
        FOR C IN (
            SELECT s.label, s.property, s.min, s.max, NVL(ws.value, s.value) AS value 
              FROM styles s, website_styles ws
             WHERE s.id=pStyleId
               AND ws.website_id(+)=pWebsiteid
               AND ws.style_id(+)=s.id
        ) LOOP
            IF (C.max IS NOT NULL) THEN -- build input type="range"
                l_properties:=
                '<label for="' || C.property || '">Adjust value:</label>' ||
                '<input type="range" id="' || C.property || '" min="' || C.min || '" max="' || C.max || '" value="' || regexp_substr(C.value,'\d+') || '">';
            ELSIF (C.value LIKE '#%') THEN -- build input type="color"
                l_properties:=
                '<label for="' || C.property || '">Select colour:</label>' ||
                '<input type="color" id="' || C.property || '" value="' || C.value || '">';
            END IF;       
        END LOOP;
        
        RETURN (l_properties);
    END;

    /* 
    **  BUILD FORM CONTROLS TO MANAGE WEBSITE STYLES
    */
    PROCEDURE getStylesForm(pWebsiteId IN website.id%type, pArticleId IN article.id%type, pStyle IN NUMBER, pScope IN VARCHAR2, pStatus OUT NUMBER) IS
        l_session_data pck_sec.t_session_data;
        l_header LONG;
        l_article CLOB;
        l_footer LONG;
        l_controls LONG;
        l_json JSON_OBJECT_T;
        n PLS_INTEGER;
    BEGIN
        l_session_data:=pck_sec.getSessionData(pWebsiteId);


        /*
        **  pStyles NULL is opening dialog - return all styles
        **  pStyles NOT NULL is user selected top level style - return control(s) for selected style 
        */

        IF (pStyle IS NOT NULL) THEN
            n:=0;
            FOR C IN (
                SELECT s.label, s.id, s.parent_id, s.property, s.min, s.max, ws.value, COUNT(*) OVER () nb
                  FROM styles s, website_styles ws
                 WHERE s.parent_id=pStyle
                   AND ws.website_id(+)=pWebsiteId
                   AND ws.style_id(+)=s.parent_id
            ) LOOP
                IF (C.nb=1) THEN -- range input
                    l_controls:=
                    '<label for="' || SUBSTR(C.property,3) || '">Adjust value:</label>' ||
                    '<input type="range" id="' || SUBSTR(C.property,3) || '" min="' || C.min || '" max="' || C.max || '" value="' || regexp_substr(C.value,'\d+') || '">';
                    EXIT;
                END IF;
                n:=n+1;
                -- radio controls
                IF (n=1) THEN
                    l_controls:=l_controls ||
                    '<div class="flex-items show-controls">';
                END IF;
                l_controls:=l_controls ||
                '<div>' ||
                    '<input id="' || C.label || '" type="radio" name="controls" value="' || C.id || '"' || CASE WHEN C.value=C.id THEN ' checked' END || '>' ||
                    '<label for="' || C.label || '" style="margin-inline-start:var(--space-3xs)">' || C.label || '</label>' ||
                '</div>';
            END LOOP;
            IF (n>0) THEN
                l_controls:=l_controls ||
                '</div>';
            END IF;
            l_json:= new JSON_OBJECT_T;
            l_json.put('controls',l_controls);
            apex_util.prn(l_json.to_clob,false);
            pStatus:=200;
            RETURN;
        END IF;
        
        l_header:=
        '<h4>Update Styles</h4>' ||
        '<div class="flex-items show-controls">' ||
            '<div>' ||
                '<input id="website-styles" type="radio" name="scope" checked>' ||
                '<label for="website-styles" style="margin-inline-start:var(--space-3xs)">All Pages</label>' ||
            '</div>' ||
            '<div>' ||
                '<input id="page-styles" type="radio" name="scope">' ||
                '<label for="page-styles" style="margin-inline-start:var(--space-3xs)">Current Page</label>' ||
            '</div>' ||
        '</div>';

        l_article:=
        '<fieldset>' ||
            '<legend>Select style</legend>' ||
            '<div class="flex-items">' ||
                -- '<label class="block" for="styles"></label>' ||
                '<select id="styles" style="--width:fit-content">' ||
                    '<button>' ||
                        '<selectedcontent></selectedcontent>' ||
                    '</button>' ||
                    '<option value="">-- Choose styling element --</option>';

        FOR C IN (
            SELECT id, parent_id, label, property, value
              FROM styles
             WHERE parent_id IS NULL
             ORDER BY id
        ) LOOP
            l_article:=l_article ||
            '<option value="' || C.id || '">' || C.label || '</option>';
        END LOOP;

        l_article:=l_article ||
                '</select>' ||
                '<div class="flex-items" style="--flex-gap:var(--space-s)"></div>' ||
            '</div>' ||
        '</fieldset>';

        l_footer:=
        '<div class="flex-items">' ||
            '<button type="button" class="button publish">PUBLISH</button>' ||
            '<span aria-live="polite"></span>' ||
            '<span class="loader icon"></span>' ||
        '</div>';

        l_json:= new JSON_OBJECT_T;
        l_json.put('success',true);
        l_json.put('header',l_header);
        l_json.put('article',l_article);
        l_json.put('footer',l_footer);
        apex_util.prn(l_json.to_clob,false);

        pStatus:=200;

    EXCEPTION WHEN OTHERS THEN
        pck_core.log_error(pStatus);

    END;

    /* 
    **  UPDATE A STYLE
    */
    PROCEDURE updateStyle(pWebsiteId IN NUMBER, pArticleid IN NUMBER, pBodyText IN CLOB, pStatus OUT NUMBER) IS
        l_session_data pck_sec.t_session_data;
        l_bodytext CLOB;
        l_scope VARCHAR2(15);
        l_style_id NUMBER;
        l_value NUMBER;
        l_json JSON_OBJECT_T;
        l_arr JSON_ARRAY_T;
        l_obj JSON_OBJECT_T;
        l_message VARCHAR2(100);
        n PLS_INTEGER;
    BEGIN
        l_session_data:=pck_sec.getSessionData(pWebsiteId);

        l_bodytext:=pBodyText;

        SELECT scope, style_id, value
          INTO l_scope, l_style_id, l_value
          FROM JSON_TABLE(l_bodytext, '$' COLUMNS(scope, style_id, value));

        CASE l_scope
            WHEN 'website-styles' THEN
                MERGE INTO website_styles t
                USING (
                    SELECT style_id, value FROM JSON_TABLE(l_bodytext, '$' COLUMNS(style_id, value))
                ) s
                ON (t.website_id=pWebsiteid AND t.style_id=s.style_id)
                WHEN MATCHED THEN      
                    UPDATE SET t.value=s.value, t.updated_date=current_timestamp
                WHEN NOT MATCHED THEN
                    INSERT (website_id, style_id, value) VALUES (pWebsiteid, s.style_id, s.value);

                SELECT '<span>Updated ' || label || ' for all pages</span>' INTO l_message FROM styles WHERE id=l_style_id;

            WHEN 'page-styles' THEN
                MERGE INTO website_article_styles t
                USING (
                    SELECT style_id, value FROM JSON_TABLE(l_bodytext, '$' COLUMNS(style_id, value))
                ) s
                ON (t.website_id=pWebsiteid AND t.article_id=pArticleid AND t.style_id=s.style_id)
                WHEN MATCHED THEN      
                    UPDATE SET t.value=s.value, t.updated_date=current_timestamp
                WHEN NOT MATCHED THEN
                    INSERT (website_id, article_id, style_id, value) VALUES (pWebsiteid, pArticleid, s.style_id, s.value);

                SELECT '<span>Updated ' || s.label || ' for ' || wa.navigation_label || ' page</span>' INTO l_message 
                  FROM styles s, website_article wa
                 WHERE s.id=l_style_id
                   AND wa.website_id=pWebsiteid
                   AND wa.article_id=pArticleid;
        END CASE;
        /* RETURN PROPERTIES WHERE DEFINED FOR STYLE */
        n:=0;      
        FOR C IN (
            SELECT property, value FROM styles WHERE parent_id=l_value ORDER BY id
        ) LOOP
            n:=n+1;
            IF (n=1) THEN
                l_arr:=new JSON_ARRAY_T;
            END IF;
            l_obj:=new JSON_OBJECT_T;
            l_obj.put('name',C.property);
            l_obj.put('value',C.value);
            l_arr.append(l_obj);
        END LOOP;

        l_json:= new JSON_OBJECT_T;
        l_json.put('message',l_message);
        l_json.put('properties',l_arr);
        apex_util.prn(l_json.to_clob,false);

        pStatus:=200;

        pck_sec.updateCpuUsed(pWebsiteId=>pWebsiteId, pUserid=>l_session_data.user_id, pCpuUsedStart=>l_session_data.cpu_used_session);

    EXCEPTION WHEN OTHERS THEN
        pck_core.log_error(pStatus);

    END;

    /*
    ** BUILD FLUID TYPES AND SPACES
    */
    PROCEDURE initFluidTypes( pParentid IN NUMBER, pMinWidthPx IN NUMBER, pMinFontSizePx IN NUMBER, pMinScale IN NUMBER, pMaxWidthPx IN NUMBER, pMaxFontSizePx IN NUMBER, pMaxScale IN NUMBER) IS
        l_min_font NUMBER;
        l_min_width NUMBER;
        l_min_font_size NUMBER;

        l_max_font NUMBER;
        l_max_width NUMBER;
        l_max_font_size NUMBER;
        
        TYPE tt_spaces IS RECORD(dimension VARCHAR2(3), multiplier NUMBER);
        TYPE t_spaces IS TABLE OF tt_spaces INDEX BY PLS_INTEGER;
        l_spaces t_spaces:=t_spaces(
            1=>tt_spaces('3xs',0.25), 
            2=>tt_spaces('2xs',0.5), 
            3=>tt_spaces('xs',0.75), 
            4=>tt_spaces('s',1), 
            5=>tt_spaces('m',1.5), 
            6=>tt_spaces('l',2), 
            7=>tt_spaces('xl',3), 
            8=>tt_spaces('2xl',4), 
            9=>tt_spaces('3xl',6)
        );

        FUNCTION round4dp(pNumber IN NUMBER) RETURN VARCHAR2 IS
            l_number NUMBER;
        BEGIN
            l_number:=ROUND(pNumber,4);
            IF (MOD(l_number,1)=0) THEN /* integer */
                RETURN (TO_CHAR(l_number));
            ELSE
                RETURN(LTRIM(RTRIM(TO_CHAR(ROUND(pNumber,4),'fm90.0000'),'0')));
            END IF;
        END;

        PROCEDURE addFluidType(pProperty IN VARCHAR2) IS 
            l_slope NUMBER;
            l_intersect NUMBER;
            l_value VARCHAR2(100);
        BEGIN
            l_slope:=(l_max_font - l_min_font) / (l_max_width - l_min_width);
            l_intersect:= l_min_font - (l_min_width * l_slope);

            l_value:='clamp(' || round4dp(l_min_font) || 'rem,' || round4dp(l_intersect) || 'rem + ' || round4dp(l_slope * 100) || 'cqi,' || round4dp(l_max_font) || 'rem)';

            INSERT INTO styles(id, parent_id, property, value)
            VALUES (seq_style.nextval, pParentid, pProperty, l_value);
        END;

    BEGIN
        /* Delete any existing style for parent_id */
        DELETE styles WHERE parent_id=pParentid;
        
        /* Convert pixels to rem */
        l_min_width:=pMinWidthPx/16; 
        l_max_width:=pMaxWidthPx/16;
        l_min_font_size:=pMinFontSizePx/16;
        l_max_font_size:=pMaxFontSizePx/16;

        /* Fluid types */
        FOR i IN -2 .. 5 LOOP
            IF (i<0) THEN
                l_min_font:=l_min_font_size/(pMinScale**ABS(i));
                l_max_font:=l_max_font_size/(pMaxScale**ABS(i));
            ELSE
                l_min_font:=l_min_font_size*(pMinScale**i);
                l_max_font:=l_max_font_size*(pMaxScale**i);
            END IF;
            /* Check WCAG SC 1.4.4 - zoom text is minimum 2x original size */
            IF (l_max_font/l_min_font>2.5) THEN
                RAISE_APPLICATION_ERROR(-20000,'--step-' || i || ' - WCAG SC 1.4.4 FAIL');
            END IF;
            
            addFluidType('--step-' || i);
        END LOOP;

        /* Fluid spaces */
        FOR i IN 1..l_spaces.COUNT LOOP
            l_min_font:=l_min_font_size*l_spaces(i).multiplier;
            l_max_font:=l_max_font_size*l_spaces(i).multiplier;
            addFluidType('--space-' || l_spaces(i).dimension);
        END LOOP;

        /* Fluid space pairs */
        FOR i IN 1..l_spaces.COUNT-1 LOOP
            l_min_font:=l_min_font_size*l_spaces(i).multiplier;
            l_max_font:=l_max_font_size*l_spaces(i+1).multiplier;
            addFluidType('--space-' || l_spaces(i).dimension || '-' || l_spaces(i+1).dimension);
        END LOOP;
    END;

    /*
    ** BUILD STYLES TABLE HIERARCHY
    **
    ** LEVEL 1 - options shown in style drop down select list
    ** LEVEL 2 - options for a given level 1 option - the user selected ID is refrenced in table WEBSITE_STYLES or WEBSITE_ARTICLE_STYLES
    ** LEVEL 3 - CSS properties and values used in building site CSS tokens file
    */
    PROCEDURE initStyles IS
        TYPE tt_styles IS RECORD(
            label VARCHAR2(30), 
            min NUMBER, 
            max NUMBER, 
            input_type VARCHAR2(8),
            tooltip VARCHAR2(100)
        );
        TYPE t_styles IS TABLE OF tt_styles INDEX BY PLS_INTEGER;
        
        l_styles t_styles:=t_styles(
            1=>tt_styles('Content Width', 800, 1600, 'range',''),
            2=>tt_styles('Colours', null, null, 'radio',''),
            3=>tt_styles('Text Size', null, null, 'radio','')
        );
        --
        TYPE tt_fluid_types IS RECORD(
            label VARCHAR2(30),
            max_font_size NUMBER,
            max_scale NUMBER
        );
        TYPE t_fluid_types IS TABLE OF tt_fluid_types INDEX BY PLS_INTEGER;

        l_fluid_types t_fluid_types:=t_fluid_types(
            1=>tt_fluid_types('Small', 20, 1.33),
            2=>tt_fluid_types('Regular', 24, 1.33),
            3=>tt_fluid_types('Large', 28, 1.25)
        );
        --
        TYPE tt_colours IS RECORD(
            theme VARCHAR2(10),
            appearance VARCHAR2(5),
            property VARCHAR2(30),
            value VARCHAR2(30));
        TYPE t_colours IS TABLE OF tt_colours INDEX BY PLS_INTEGER;

        l_colours t_colours:=t_colours(
            1=>tt_colours('slate','light','color-bg','#fffefd'),
            2=>tt_colours('slate','light','color-bg-accent','#f7f5f5'),
            3=>tt_colours('slate','light','color-text','#020617'),
            4=>tt_colours('slate','light','color-text-accent','#334155'),
            5=>tt_colours('slate','light','color-link','#2563eb'),
            6=>tt_colours('slate','light','color-link-hover','#ec4899'),
            7=>tt_colours('slate','light','color-theme','#ffedd5'),
            8=>tt_colours('slate','light','color-theme-muted','#fff5e7'),
            9=>tt_colours('slate','light','color-theme-accent','#fed7aa'),
            10=>tt_colours('slate','light','color-theme-offset','#ef4444'),
            11=>tt_colours('slate','dark','color-bg','#020617'),
            12=>tt_colours('slate','dark','color-bg-accent','#0f172a'),
            13=>tt_colours('slate','dark','color-text','#f8fafc'),
            14=>tt_colours('slate','dark','color-text-accent','#f1f5f9'),
            15=>tt_colours('slate','dark','color-link','#7ab6ff'),
            16=>tt_colours('slate','dark','color-link-hover','#93c5fd'),
            17=>tt_colours('slate','dark','color-theme','#172554'),
            18=>tt_colours('slate','dark','color-theme-muted','#0e1737'),
            19=>tt_colours('slate','dark','color-theme-accent','#1e3a8a'),
            20=>tt_colours('slate','dark','color-theme-offset','#0ea5e9')
        );
        l_theme VARCHAR2(10);
        l_theme_id NUMBER;

    BEGIN
        DELETE styles;
        
        FOR i IN 1..l_styles.COUNT LOOP
            INSERT INTO styles(id, label, min, max, input_type)
            VALUES (i, l_styles(i).label, l_styles(i).min, l_styles(i).max, l_styles(i).input_type);

            CASE l_styles(i).label
                WHEN 'Content Width' THEN
                    INSERT INTO styles(parent_id, id, label, min, max, property)
                        VALUES (i, seq_style.nextval, l_styles(i).label, l_styles(i).min, l_styles(i).max, '--max-width');

                WHEN 'Text Size' THEN
                    FOR j IN 1..l_fluid_types.COUNT LOOP
                        INSERT INTO styles(parent_id, id, label)
                        VALUES (i, seq_style.nextval, l_fluid_types(j).label);
                        initFluidTypes(
                            pParentid=>seq_style.currval,
                            pMinWidthPx=>340,
                            pMinFontSizePx=>17,
                            pMinScale=>1.2,
                            pMaxWidthPx=>1600,
                            pMaxFontSizePx=>l_fluid_types(j).max_font_size,
                            pMaxScale=>l_fluid_types(j).max_scale);
                    END LOOP;

                WHEN 'Colours' THEN
                    FOR j IN 1..l_colours.COUNT LOOP
                        IF (l_colours(j).theme<>l_theme OR l_theme IS NULL) THEN
                            l_theme:=l_colours(j).theme;
                            l_theme_id:=seq_style.nextval;
                            INSERT INTO styles(parent_id, id, label)
                            VALUES (i, l_theme_id, l_colours(j).theme);
                        END IF;
                        INSERT INTO styles(parent_id, id, appearance, property, value)
                        VALUES (l_theme_id, seq_style.nextval, l_colours(j).appearance, l_colours(j).property, l_colours(j).value);
                    END LOOP;
            END CASE;
        END LOOP;

    END;

end "PCK_STYLES";
/