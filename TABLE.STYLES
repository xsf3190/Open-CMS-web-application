CREATE TABLE "STYLES" 
   (	"ID" NUMBER, 
	"PARENT_ID" NUMBER, 
	"LABEL" VARCHAR2(30), 
	"PROPERTY" VARCHAR2(30), 
	"VALUE" VARCHAR2(100), 
	"APPEARANCE" VARCHAR2(5), 
	 CONSTRAINT "PK_STYLES" PRIMARY KEY ("ID")
  USING INDEX  ENABLE, 
	 CONSTRAINT "FK_STYLES_PARENT_ID" FOREIGN KEY ("PARENT_ID")
	  REFERENCES "STYLES" ("ID") ENABLE
   ) ;

  CREATE UNIQUE INDEX "PK_STYLES" ON "STYLES" ("ID") 
  ;