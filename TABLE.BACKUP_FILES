CREATE TABLE "BACKUP_FILES" 
   (	"FILE_NAME" VARCHAR2(30), 
	"BACKUP_DATE" TIMESTAMP (6) WITH TIME ZONE DEFAULT current_timestamp, 
	"FILE_PATH" VARCHAR2(10), 
	 CONSTRAINT "PK_BACKUP_FILES" PRIMARY KEY ("FILE_NAME")
  USING INDEX  ENABLE
   ) ;

  CREATE UNIQUE INDEX "PK_BACKUP_FILES" ON "BACKUP_FILES" ("FILE_NAME") 
  ;