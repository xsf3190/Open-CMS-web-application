CREATE OR REPLACE EDITIONABLE PACKAGE "PCK_COLLECTIONS" as
    --
    PROCEDURE getCollectionForm(pWebsiteId IN NUMBER, pArticleId IN NUMBER, pCollection IN NUMBER, pCollectionItem IN NUMBER, pStatus OUT NUMBER);
    --
    PROCEDURE updateCollection(pWebsiteId IN NUMBER, pArticleId IN NUMBER, pBodyText IN CLOB, pStatus OUT NUMBER);
    --
end "PCK_COLLECTIONS";
/
CREATE OR REPLACE EDITIONABLE PACKAGE BODY "PCK_COLLECTIONS" as

    FUNCTION getCollectionItemHTML(pCollectionItem IN NUMBER) RETURN CLOB
    IS
        l_html CLOB;
    BEGIN
        FOR C IN (
            SELECT a.parent_id, a.title, a.excerpt, wa.navigation_label
              FROM article a, website_article wa
             WHERE a.id=pCollectionItem
               AND wa.article_id=a.parent_id
        ) LOOP
            l_html:=
            '<div>' ||
                '<label for="excerpt-upd" class="block">Update excerpt</label>' ||
                '<textarea id="excerpt-upd" maxlength="160" style="min-width:50ch">' || C.excerpt || '</textarea>' ||
            '</div>' ||

            '<fieldset>' ||
                '<legend>Link related ' || C.navigation_label || '</legend>' ||
                '<p><a href="#skip">Skip to next</a></p>';
            FOR C1 IN (
                WITH checked AS
                (
                    SELECT article_id_2 FROM article_link WHERE article_id_1=pCollectionItem
                )
                SELECT a.id, a.title, l.article_id_2, ROW_NUMBER() OVER (ORDER BY a.title) rn
                  FROM article a, checked l
                 WHERE a.parent_id=C.parent_id
                   AND a.id<>pCollectionItem
                   AND a.id=l.article_id_2(+)
                 ORDER BY a.title
            ) LOOP
                l_html:=l_html ||
                '<input type="checkbox" name="link" id="link' || C1.rn || '" value="' || C1.id || '"' || CASE WHEN C1.article_id_2 IS NOT NULL THEN ' checked' END || '>' || 
                '<label for="link' || C1.rn || '">' || C1.title || '</label>';
            END LOOP;
            l_html:=l_html ||
            '</fieldset>' ||
            '<p id="skip"></p>' ||
            '<hr>' ||
            '<div class="flex-items space-between no-wrap">' ||
                '<span>' || C.title || '</span>' ||
                '<button type="button" class="button del-item" data-collection-item="' || pCollectionItem || '" style="--button-bg:red">DELETE</button>' ||
            '</div>' ||
            '<hr>';

        END LOOP;
        
        RETURN (l_html);
    END;

    /*
    ** BUILD HTML FOR COLLECTION DATA RELATED TO A SELECTED COLLECTION
    */
    FUNCTION getCollectionHTML(pParentid IN NUMBER, pNavigationLabel IN VARCHAR2) RETURN CLOB
    IS
        l_html CLOB;
        TYPE t_items IS RECORD(
            id NUMBER,
            title article.title%type,
            excerpt article.excerpt%type,
            updated_date article.updated_date%type
        );
        TYPE tt_items IS TABLE OF t_items;
        l_items tt_items;
    BEGIN
        l_html:=l_html ||
        '<details open>' ||
                '<summary>New ' || INITCAP(pNavigationLabel) || '</summary>' ||
            '<fieldset class="flow">' ||
                '<legend>Create new ' || INITCAP(pNavigationLabel) || '</legend>' ||
                '<div>' ||
                    '<label for="title" class="block">Enter title *</label>' ||
                    '<textarea id="title" maxlength="100" aria-describedby="title-error" aria-invalid="false" style="min-width:40ch"></textarea>' ||
                    '<span id="title-error" class="block message"></span>' ||
                '</div>' ||
                '<div>' ||
                    '<label for="excerpt" class="block">Enter excerpt</label>' ||
                    '<textarea id="excerpt" name="excerpt" maxlength="160" style="min-width:50ch"></textarea>' ||
                '</div>' ||
                '<button type="button" class="button add-item" data-parent-id="' || pParentid || '">NEW ' || UPPER(pNavigationLabel) || '</button>' ||
            '</fieldset>'||
        '</details>' ||
        '<div>' ||
            '<label class="block" for="collection-items">Select ' || INITCAP(pNavigationLabel) || '</label>' ||
            '<select id="collection-items" data-collection="' || pParentid || '">' ||
                '<button>' ||
                    '<selectedcontent></selectedcontent>' ||
                    '<span class="arrow"></span>' ||
                '</button>';
        
        SELECT a.id, a.title, a.excerpt, NVL(a.updated_date,a.created_date) updated_date
          BULK COLLECT INTO l_items
          FROM article a 
         WHERE a.parent_id=pParentid 
        ORDER BY updated_date DESC;

        IF (l_items.COUNT>0) THEN
            FOR i IN 1..l_items.COUNT LOOP
                IF (i=1) THEN
                    l_html:=l_html ||
                    '<option value"0">--Choose from ' || l_items.COUNT || ' item' || CASE WHEN l_items.COUNT>1 THEN 's' END || ' --</option>';
                END IF;
                l_html:=l_html ||
                '<option value="' || l_items(i).id || '">' || l_items(i).title || '</option>';
            END LOOP;
        END IF;

        l_html:=l_html ||
            '</select>' ||
        '</div>';

        RETURN (l_html);
    END;

    /* 
    **  BUILD FORM CONTROLS TO MANAGE COLLECTION PAGES AND SUB-PAGES
    **  pArticleId IS ID OF CALLING PAGE WHICH IS NOT NECESSARILY A COLLECTION PAGE
    */
    PROCEDURE getCollectionForm(pWebsiteId IN NUMBER, pArticleId IN NUMBER, pCollection IN NUMBER, pCollectionItem IN NUMBER, pStatus OUT NUMBER) IS
        l_session_data pck_sec.t_session_data;
        l_header LONG;
        l_article CLOB;
        l_footer LONG;
        l_parent_id NUMBER;
        l_navigation_label website_article.navigation_label%type;
        l_json JSON_OBJECT_T;
        n PLS_INTEGER;

        TYPE t_collections IS RECORD(
            parent_id NUMBER,
            navigation_label website_article.navigation_label%type
        );
        TYPE tt_collections IS TABLE OF t_collections;
        l_collections tt_collections; 
    BEGIN
        l_session_data:=pck_sec.getSessionData(pWebsiteId);

        /* 
        ** pItem is the ID of a selected collection item  
        ** Return HTML of the item to replace item content in the form 
        */
        IF (pCollectionItem IS NOT NULL) THEN
            l_json:= new JSON_OBJECT_T;
            l_json.put('item',getCollectionItemHTML(pCollectionItem));
            apex_util.prn(l_json.to_clob,false);
            pStatus:=200;
            RETURN;
        END IF;
        
        /* 
        ** pCollectionItem is the ID of a selected collection 
        ** Return HTML of the collection to replace content in the form 
        */
        IF (pCollection IS NOT NULL) THEN
            SELECT navigation_label INTO l_navigation_label FROM website_article WHERE article_id=pCollection;
            l_json:= new JSON_OBJECT_T;
            l_json.put('collection',getCollectionHTML(pCollection, l_navigation_label));
            apex_util.prn(l_json.to_clob,false);
            pStatus:=200;
            RETURN;
        END IF;

        

        l_header:='<h4>Manage Collection Pages</h4>';

        /* 
        ** If website has more than 1 collection page show these like
        ** selectable navigation labels with the first selected (unless
        ** user's current page is a collection page in which case that's selected).
        ** Otherwise skip this control as there's only one collection page
        */
        SELECT wa.article_id, wa.navigation_label
          BULK COLLECT INTO l_collections
          FROM website_article wa
         WHERE wa.website_id=pWebsiteid
           AND wa.collection=1
         ORDER BY wa.display_order;

        IF (l_collections.COUNT=0) THEN
            l_article:=
            '<p>No collection pages in website</p>' ||
            '<p>Create collection pages using the "Pages" menu option</p>';
            l_json:= new JSON_OBJECT_T;
            l_json.put('header',l_header);
            l_json.put('article',l_article);
            l_json.put('footer',l_footer);
            apex_util.prn(l_json.to_clob,false);
            pStatus:=200;
            RETURN;
        END IF;

        /*
        ** THE FIRST FIELDSET EXISTS ONLY TO ALLOW USER TO SELECT FROM MULTIPLE COLLECTION PAGES
        */
        IF (l_collections.COUNT=1) THEN
            l_parent_id:=l_collections(1).parent_id;
            l_navigation_label:=RTRIM(UPPER(l_collections(1).navigation_label),'S');
        ELSE
            FOR i IN 1..l_collections.COUNT LOOP
                IF (l_collections(i).parent_id=pArticleid) THEN
                    l_parent_id:=l_collections(i).parent_id;
                    l_navigation_label:=RTRIM(UPPER(l_collections(i).navigation_label),'S');
                END IF;
            END LOOP;
            IF (l_parent_id IS NULL) THEN
                l_parent_id:=l_collections(1).parent_id;
                l_navigation_label:=RTRIM(UPPER(l_collections(1).navigation_label),'S');
            END IF;

            l_article:=
            '<fieldset class="hide-controls flex-items">' ||
                '<legend>Select collection page</legend>';
            FOR i IN 1..l_collections.COUNT LOOP
                l_article:=l_article ||
                '<div>' ||
                    '<input id="page-' || i || '" type="radio" name="collection" data-parent-id="' || l_collections(i).parent_id || '"' || CASE WHEN l_collections(i).parent_id=l_parent_id THEN ' checked' END || '>' ||
                    '<label for="page-' || i || '">' || l_collections(i).navigation_label || '</label>' ||
                '</div>';
            END LOOP;
            l_article:=l_article ||
            '</fieldset>';
        END IF;

        l_article:=l_article ||
        '<div id="collection" class="flow">' ||
            getCollectionHTML(l_parent_id, l_navigation_label) ||
        '</div>' ||
        
        '<div id="collection-item" class="flow"></div>';
        
        l_footer:=
        '<div class="flex-items">' ||
            '<button type="button" class="button upd-item">UPDATE</button>' ||
            '<button type="button" class="button publish">PUBLISH</button>' ||
            '<span aria-live="polite"></span>' ||
            '<span class="loader icon"></span>' ||
        '</div>';

        l_json:= new JSON_OBJECT_T;
        l_json.put('success',true);
        l_json.put('header',l_header);
        l_json.put('article',l_article);
        l_json.put('footer',l_footer);
        apex_util.prn(l_json.to_clob,false);

        pStatus:=200;

    EXCEPTION WHEN OTHERS THEN
        pck_core.log_error(pStatus);

    END;

    /* 
    **  INSERT OR UPDATE A COLLECTION ITEM
    */
    PROCEDURE updateCollection(pWebsiteId IN NUMBER, pArticleid IN NUMBER, pBodyText IN CLOB, pStatus OUT NUMBER) IS
        l_session_data pck_sec.t_session_data;
        l_bodytext CLOB:=pBodytext;
        l_action VARCHAR2(6);
        l_parentid NUMBER;
        l_json JSON_OBJECT_T;
        l_message VARCHAR2(50);
        l_new_id NUMBER;
        n PLS_INTEGER;
    BEGIN
        l_session_data:=pck_sec.getSessionData(pWebsiteId);

        SELECT action INTO l_action FROM JSON_TABLE(l_bodytext, '$' COLUMNS(action));

        CASE l_action
            WhEN 'insert' THEN
                FOR C IN (
                    SELECT wa.navigation_label, j.parent_id, j.title, j.excerpt
                      FROM JSON_TABLE(l_bodytext, '$' COLUMNS(parent_id, id, title, excerpt)) j, website_article wa
                     WHERE wa.website_id=pWebsiteId
                       AND wa.article_id=j.parent_id
                ) LOOP
                    IF (TRIM(C.title) IS NULL) THEN
                        l_message:='Title is a required field';
                        EXIT;
                    END IF;
                    SELECT COUNT(*) INTO n FROM dual WHERE EXISTS(
                        SELECT null
                          FROM article a
                         WHERE a.parent_id=C.parent_id
                           AND a.title=C.title);
                    IF (n=0) THEN
                        INSERT INTO article(id, parent_id, title, excerpt, author_user_id, updated_date, body_html)
                        VALUES (seq_article.nextval, C.parent_id, C.title, C.excerpt, l_session_data.user_id, current_timestamp, '<h2>' || C.title || '</h2><p>' || C.excerpt || '</p>');
                        l_new_id:=seq_article.currval;
                        l_parentid:=C.parent_id;
                    ELSE
                        l_message:='Title already exists';
                    END IF;
                END LOOP;

            WHEN 'update' THEN
                FOR C IN (
                    SELECT collection_item, excerpt FROM JSON_TABLE(l_bodytext, '$' COLUMNS (collection_item, excerpt))
                ) LOOP
                    UPDATE article 
                       SET excerpt=C.excerpt, updated_date=current_timestamp 
                     WHERE id=C.collection_item 
                    RETURNING parent_id INTO l_parentid;

                    DELETE article_link WHERE article_id_1=C.collection_item;
                    
                    INSERT INTO article_link(article_id_1, article_id_2)
                    SELECT collection_item, article_id_2 FROM JSON_TABLE(l_bodytext, '$' COLUMNS (collection_item, NESTED '$.links[*]' COLUMNS (article_id_2 PATH '$')))
                     WHERE article_id_2 IS NOT NuLL;
                END LOOP;

            WHEN 'delete' THEN
                FOR C IN (
                    SELECT collection_item FROM JSON_TABLE(l_bodytext, '$' COLUMNS (collection_item))
                ) LOOP
                    DELETE article WHERE id=C.collection_item RETURNING parent_id INTO l_parentid;
                END LOOP;

        END CASE;

        l_json:= new JSON_OBJECT_T;

        /* "l_message" either has error condition or action was successful */
        IF (l_message IS NULL) THEN
            SELECT RTRIM(INITCAP(wa.navigation_label),'s') || ' ' || l_action || CASE WHEN l_action='insert' THEN 'ed' ELSE 'd' END || ' successfully'
              INTO l_message
              FROM website_article wa
             WHERE wa.website_id=pWebsiteid
               AND wa.article_id=l_parentid;
        END IF;
        l_json.put('message',l_message);

        IF (l_new_id IS NOT NULL) THEN
            l_json.put('new_id',l_new_id);
            l_json.put('item',getCollectionItemHTML(l_new_id));
        END IF;
        
        apex_util.prn(l_json.to_clob,false);

        pStatus:=200;

        pck_sec.updateCpuUsed(pWebsiteId=>pWebsiteId, pUserid=>l_session_data.user_id, pCpuUsedStart=>l_session_data.cpu_used_session);

    EXCEPTION WHEN OTHERS THEN
        pck_core.log_error(pStatus);

    END;

end "PCK_COLLECTIONS";
/